<Window x:Class="ConvertApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert"
        Width="500"
        SizeToContent="Height"
        MaxHeight="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#17171B"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2EA8FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF5FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#17171B" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6C6C78" />
        <SolidColorBrush x:Key="Line" Color="#E5E5EA" />
        <SolidColorBrush x:Key="FieldBorder" Color="#D8D8DF" />

        <!-- Buttons -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9E9EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="18,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E9BFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1689E4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combo box item -->
        <Style x:Key="PickerItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Combo box -->
        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerItem}" />
            <Setter Property="Template">

                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#8A8A96" StrokeThickness="1.4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FFFFFF" BorderBrush="#DDDDE4" BorderThickness="1" CornerRadius="8"
                                        Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="330" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B9B9C4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin progress bar -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#EDEDF2" CornerRadius="2.5" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{StaticResource Accent}" RadiusX="2.5" RadiusY="2.5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Advanced disclosure -->
        <Style x:Key="AdvancedToggleStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Path x:Name="Chevron" Data="M0,0 L4.5,4.5 L0,9" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                  VerticalAlignment="Center" Margin="1,1,7,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#FFFFFF">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                        <Grid>
                            <Path x:Name="HeaderIcon" Stroke="{StaticResource Accent}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="24" Height="24" Stretch="Uniform" />
                            <Image x:Name="HeaderImage" Width="32" Height="32" Source="Resources/AppIcon.ico"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <StackPanel x:Name="DropZone">
                    <Grid Height="158">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="#C9C9D2" StrokeThickness="1.4" StrokeDashArray="2 2" Fill="#FBFBFC" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M8,14 L8,26 M2,20 L8,14 L14,20 M3,27 L13,27"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"
                                  HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Drop audio, video, images, documents or PDFs"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <Button Content="Choose Files…" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" Click="ChooseFiles_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MenuHintText" Text="Add “Convert…” to Explorer’s right-click menu"
                                       VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" />
                            <Button x:Name="MenuHintButton" Grid.Column="1" Content="Install"
                                    Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="10,0,0,0"
                                    Click="MenuHint_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Mixed selection warning -->
                <TextBlock x:Name="MixWarning" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"
                           Text="These files can't be converted together. Pick files of one kind (audio, video, images, documents or PDFs)." />

                <!-- Format + settings -->
                <StackPanel x:Name="FormatSection" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Convert to" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                   HorizontalAlignment="Right" Margin="0,7,12,0" />
                        <ComboBox x:Name="FormatPicker" Grid.Column="1" Style="{StaticResource Picker}"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="FormatPicker_SelectionChanged">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Margin="14,8,10,3" FontSize="11"
                                                                       FontWeight="SemiBold" Foreground="#8A8A96" />
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Grid>

                    <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource AdvancedToggleStyle}" Content="Advanced"
                                  Margin="116,12,0,0" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />

                    <StackPanel x:Name="SettingsPanel" Margin="0,12,0,0" />
                </StackPanel>

                <!-- Footer -->
                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,14" />

                <Grid x:Name="IdlePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="TrashCheck" Content="Move originals to the Recycle Bin"
                              VerticalAlignment="Center" IsChecked="{Binding TrashOriginals, Mode=TwoWay}" />
                    <TextBlock x:Name="FfmpegWarning" Visibility="Collapsed" VerticalAlignment="Center"
                               Foreground="#C77700" FontSize="12"
                               Text="Needs ffmpeg — it will download automatically." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                        <Button x:Name="ConvertButton" Content="Convert" Style="{StaticResource PrimaryButton}"
                                IsDefault="True" Click="Convert_Click" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RunningPanel" Visibility="Collapsed">
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}"
                                 Minimum="0" Maximum="1" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RunningText" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Stop" Style="{StaticResource SecondaryButton}" Click="Stop_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                    <TextBlock x:Name="DoneSummary" FontWeight="SemiBold" Foreground="#1F8A3B" TextWrapping="Wrap" />
                    <TextBlock x:Name="TrashSummary" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Visibility="Collapsed" Margin="0,4,0,0" />
                    <TextBlock x:Name="StoppedSummary" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Visibility="Collapsed" Text="Stopped" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#C62828" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RevealButton" Content="Show in Explorer" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="Reveal_Click" />
                        <Button Grid.Column="1" Content="Done" Style="{StaticResource PrimaryButton}"
                                IsDefault="True" Click="Done_Click" />
                    </Grid>
                </StackPanel>
            </StackPanel>
    </Border>
</Window>
